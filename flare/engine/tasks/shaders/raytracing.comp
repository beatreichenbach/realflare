#version 430 core

#define INF (1.0/0.0)
#define M_PI 3.14159265359

#define STOP 0
#define STANDARD 1
#define EVEN_ASPHERIC 2
#define EXTENDED_ASPHERIC 3
#define EXTENDED_ODD_ASPHERIC 4
#define CYLINDER_X 5
#define CYLINDER_Y 6

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

struct Surface {
    uint type;
    float center;
    float radius;
    float height;
    vec4 coefficients;
    float conic;
    float coating_wavelength;
    float coating_ior;
    float _pad;
};

// TODO: remove dir and pos.z
struct Ray {
    vec3 pos;
    float rrel;
    vec3 dir;
    float reflectance;
    vec2 pos_apt;
    uint _pad[2];
};

struct Intersection {
    vec3 pos;
    float incident;
    vec3 normal;
    bool hit;
};

struct Ghost {
    ivec2 path;
    uint offset;
    uint count;
};

uniform Params {
    uint surface_count;
    uint intersection_count;
    bool use_aspheric;
    uint _pad;
};

uniform uint ghost_id;

layout(std430) buffer Surfaces {
    Surface surfaces[];
};
layout(std430) buffer Iors {
    float iors[];
};
layout(std430) buffer Wavelengths {
    float wavelengths[];
};
layout(std430) buffer Ghosts {
    Ghost ghosts[];
};
layout(std430) buffer Rays {
    Ray rays[];
};
layout(std430) buffer Intersections {
    Intersection intersections[];
};
layout(std430) buffer Positions {
    vec2 transforms[];
};

// Calculate the Fresnel reflectance
// https://en.wikipedia.org/wiki/Fresnel_equations
float fresnel(
    float theta0,
    float n1,
    float n2
) {
    float theta1 = asin(sin(theta0) * n1 / n2);
    float cosi = cos(theta0);
    float cost = cos(theta1);
    float rs = ((n1 * cosi) - (n2 * cost)) / ((n1 * cosi) + (n2 * cost));
    float rp = ((n1 * cost) - (n2 * cosi)) / ((n1 * cost) + (n2 * cosi));
    float r = (rs * rs + rp * rp) / 2;
    return r;
}

// Calculate the reflectivity for two media using Schlick's approximation
float fresnel_schlick(float theta0, float n1, float n2) {
    float cosi = cos(theta0);
    float r0 = (n1 - n2) / (n1 + n2);
    r0 = r0 * r0;
    return r0 + (1.0 - r0) * pow(1.0 - cosi, 5.0);
}

// Calculate the reflectivity for a wavelength passing through
// 2 mediums with a coating layer.
// [Ritschel et al. 2009] Supplemental Material - Anti-reflective Coating
float fresnel_ar(
    float theta0,  // angle of incidence
    float wavelength,  // wavelength of ray
    float d1,  // thickness of AR coating
    float n0,  // refractive index of 1st medium
    float n1,  // refractive index of coating layer
    float n2  // refractive index of 2nd medium
) {
    // Refraction angles in coating and the 2nd medium
    float theta1 = asin(sin(theta0) * n0 / n1);
    float theta2 = asin(sin(theta0) * n0 / n2);

    // Amplitude for outer refl. / transmission on topmost interface
    float rs01 = -sin(theta0 - theta1) / sin(theta0 + theta1);
    float rp01 = tan(theta0 - theta1) / tan(theta0 + theta1);
    float ts01 = 2 * sin(theta1) * cos(theta0) / sin(theta0 + theta1);
    float tp01 = ts01 * cos(theta0 - theta1);

    // Amplitude for inner reflection
    float rs12 = -sin(theta1 - theta2) / sin(theta1 + theta2);
    float rp12 = tan(theta1 - theta2) / tan(theta1 + theta2);

    // After passing through first surface twice:
    // 2 transmissions and 1 reflection
    float ris = ts01 * ts01 * rs12;
    float rip = tp01 * tp01 * rp12;

    // Phase difference between outer and inner reflections
    float dy = d1 * n1;
    float dx = tan(theta1) * dy;
    float delay = sqrt(dx * dx + dy * dy);
    float relPhase = 4 * M_PI / wavelength * (delay - dx * sin(theta0));

    // Add up sines of different phase and amplitude
    float out_s2 = rs01 * rs01 + ris * ris + 2 * rs01 * ris * cos(relPhase);
    float out_p2 = rp01 * rp01 + rip * rip + 2 * rp01 * rip * cos(relPhase);
    float reflectiviy = (out_s2 + out_p2) / 2;

    return reflectiviy;
}

Intersection intersect_plane(
    Ray ray,
    float center
) {
    Intersection i;

    // |ray.dir| / distance to intersecion = dz / ray.dir.z
    float dz = center - ray.pos.z;
    i.pos = ray.pos + ray.dir * (dz / ray.dir.z);
    i.normal = (ray.dir.z < 0) ? vec3(0, 0, 1) : vec3(0, 0, -1);
    i.hit = true;
    i.incident = 0.0f;

    return i;
}

// Spherical intersection
// https://www.bluebill.net/circle_ray_intersection.html
Intersection intersect_sphere(
    Ray ray,
    float center,
    float radius
) {
    Intersection i;

    float r = abs(radius);
    vec3 C = vec3(0, 0, center);

    vec3 U = C - ray.pos;
    vec3 U1 = dot(U, ray.dir) * ray.dir;
    float d = length(U - U1);

    // discard ray if it doesn't hit the sphere
    if (d > r) {
        i.hit = false;
        return i;
    }

    // dot(A, B) = |A||B|cos(theta)
    // theta = acos(dot(A, B) / |A||B|)
    // if A and B are unit vectors, |A||B| = 1
    // acos takes values from -1 to 1, otherwise nan
    float sgn = (radius * ray.dir.z) > 0 ? -1 : 1;
    float m = sqrt((r * r) - (d * d));
    vec3 pos = ray.pos + U1 - (m * ray.dir) * sgn;
    vec3 normal = normalize(pos - C) * sgn;
    float incident = acos(clamp(dot(-ray.dir, normal), -1.0f, 1.0f));

    i.hit = true;
    i.incident = incident;
    i.pos = pos;
    i.normal = normal;
    return i;
}

// Cylindrical intersection – cylinder axis along X (CYLINDER_X) or Y (CYLINDER_Y)
// Equation for CYLINDER_X (axis = X, curved in Y-Z): (y - 0)^2 + (z - Cz)^2 = r^2
// Equation for CYLINDER_Y (axis = Y, curved in X-Z): (x - 0)^2 + (z - Cz)^2 = r^2
Intersection intersect_cylindrical(
    Ray ray,
    float center,
    float radius,
    uint type
) {
    Intersection i;
    float r = abs(radius);
    float Cz = center;

    float A, B, C;

    if (type == CYLINDER_X) {
        A = ray.dir.y * ray.dir.y + ray.dir.z * ray.dir.z;
        B = 2.0 * (ray.pos.y * ray.dir.y + (ray.pos.z - Cz) * ray.dir.z);
        C = ray.pos.y * ray.pos.y + (ray.pos.z - Cz) * (ray.pos.z - Cz) - r * r;
    } else { // CYLINDER_Y
        A = ray.dir.x * ray.dir.x + ray.dir.z * ray.dir.z;
        B = 2.0 * (ray.pos.x * ray.dir.x + (ray.pos.z - Cz) * ray.dir.z);
        C = ray.pos.x * ray.pos.x + (ray.pos.z - Cz) * (ray.pos.z - Cz) - r * r;
    }

    if (abs(A) < 1e-8) {
        i.hit = false;
        return i;
    }

    float D = B * B - 4.0 * A * C;
    if (D < 0.0) {
        i.hit = false;
        return i;
    }

    float sqrtD = sqrt(D);
    float t0 = (-B - sqrtD) / (2.0 * A);
    float t1 = (-B + sqrtD) / (2.0 * A);

    float t = 1e30;
    if (t0 > 1e-6) t = t0;
    if (t1 > 1e-6 && t1 < t) t = t1;
    if (t > 1e29) {
        i.hit = false;
        return i;
    }

    vec3 pos = ray.pos + t * ray.dir;

    float sgn = (radius * ray.dir.z) > 0.0 ? -1.0 : 1.0;
    vec3 normal;
    if (type == CYLINDER_X) {
        vec3 tmp = vec3(0.0, pos.y, pos.z - Cz);
        // tmp is (0, y, z-Cz); length should be r
        normal = normalize(tmp) * sgn;
    } else {
        vec3 tmp = vec3(pos.x, 0.0, pos.z - Cz);
        normal = normalize(tmp) * sgn;
    }

    // Ensure normal faces against incoming ray for refraction
    // (sgn already handles convex/concave, but double-check orientation)
    // If dot(-ray.dir, normal) < 0, flip – keeps consistent with sphere logic
    // (sphere logic uses sgn to achieve same, so keep as is)

    float incident = acos(clamp(dot(-ray.dir, normal), -1.0, 1.0));

    i.hit = true;
    i.incident = incident;
    i.pos = pos;
    i.normal = normal;
    return i;
}

// Aspheric sag helpers
float asphere_sag(float r, Surface s) {
    float sag = 0.0;
    float c = 0.0;
    if (abs(s.radius) > 1e-9) {
        c = 1.0 / s.radius;
    }
    float k = s.conic;
    float r2 = r * r;

    if (abs(c) > 1e-9) {
        float a = (1.0 + k) * c * c * r2;
        float v = 1.0 - a;
        v = max(v, 0.0);
        float srt = sqrt(v);
        float denom = 1.0 + srt;
        if (abs(denom) > 1e-9) {
            sag = c * r2 / denom;
        }
    }

    if (s.type == EVEN_ASPHERIC || s.type == EXTENDED_ASPHERIC) {
        // coefficients are r2, r4, r6, r8
        float r_pow = r2; // r^2
        // unrolled for vec4
        sag += s.coefficients.x * r_pow;
        r_pow *= r2; // r^4
        sag += s.coefficients.y * r_pow;
        r_pow *= r2; // r^6
        sag += s.coefficients.z * r_pow;
        r_pow *= r2; // r^8
        sag += s.coefficients.w * r_pow;
    } else if (s.type == EXTENDED_ODD_ASPHERIC) {
        // coefficients are A1*r^1, A2*r^2, A3*r^3, A4*r^4
        float r_pow = r; // r^1
        sag += s.coefficients.x * r_pow;
        r_pow *= r; // r^2
        sag += s.coefficients.y * r_pow;
        r_pow *= r; // r^3
        sag += s.coefficients.z * r_pow;
        r_pow *= r; // r^4
        sag += s.coefficients.w * r_pow;
    }
    return sag;
}

float asphere_sag_derivative(float r, Surface s) {
    if (r < 1e-9) {
        // at apex derivative is 0 for even, coeff.x for odd (r^1 term)
        if (s.type == EXTENDED_ODD_ASPHERIC) {
            return s.coefficients.x; // d/dr (A1*r) = A1
        }
        return 0.0;
    }
    float dsdr = 0.0;
    float c = 0.0;
    if (abs(s.radius) > 1e-9) {
        c = 1.0 / s.radius;
    }
    float k = s.conic;
    float r2 = r * r;
    if (abs(c) > 1e-9) {
        float a = (1.0 + k) * c * c;
        float v = 1.0 - a * r2;
        v = max(v, 0.0);
        float srt = sqrt(v);
        float denom = 1.0 + srt;
        if (abs(denom) > 1e-9 && srt > 1e-9) {
            // ds/dr = (2*c*r*denom + c*r2*a*r/srt) / denom^2
            dsdr = (2.0 * c * r * denom + c * r2 * a * r / srt) / (denom * denom);
        } else if (abs(denom) > 1e-9) {
            dsdr = (2.0 * c * r) / denom;
        }
    }
    if (s.type == EVEN_ASPHERIC || s.type == EXTENDED_ASPHERIC) {
        // even: coeff0*r^2 + coeff1*r^4 + coeff2*r^6 + coeff3*r^8
        // d/dr: 2*coeff0*r + 4*coeff1*r^3 + 6*coeff2*r^5 + 8*coeff3*r^7
        float r1 = r;
        float r3 = r2 * r;
        float r5 = r3 * r2;
        float r7 = r5 * r2;
        dsdr += 2.0 * s.coefficients.x * r1;
        dsdr += 4.0 * s.coefficients.y * r3;
        dsdr += 6.0 * s.coefficients.z * r5;
        dsdr += 8.0 * s.coefficients.w * r7;
    } else if (s.type == EXTENDED_ODD_ASPHERIC) {
        // odd: coeff0*r + coeff1*r^2 + coeff2*r^3 + coeff3*r^4
        // d/dr: coeff0 + 2*coeff1*r + 3*coeff2*r^2 + 4*coeff3*r^3
        float r1 = r;
        float r2_ = r2;
        float r3 = r2 * r;
        dsdr += s.coefficients.x;
        dsdr += 2.0 * s.coefficients.y * r1;
        dsdr += 3.0 * s.coefficients.z * r2_;
        dsdr += 4.0 * s.coefficients.w * r3;
    }
    return dsdr;
}

Intersection intersect_asphere(
    Ray ray,
    Surface s
) {
    Intersection i;
    float vertex = -s.center + s.radius; // vertex position along Z

    // initial guess: intersection with vertex plane
    float t = 1e30;
    if (abs(ray.dir.z) > 1e-9) {
        t = (vertex - ray.pos.z) / ray.dir.z;
    }
    if (t < 1e-6) {
        // if behind, try small forward step
        t = 1e-6;
    }

    // Newton iteration to solve f(t)=0 where f = ray.z(t) - (vertex + sag(r(t)))
    for (int iter = 0; iter < 12; ++iter) {
        vec3 p = ray.pos + t * ray.dir;
        float r = length(p.xy);
        float sag = asphere_sag(r, s);
        float f = p.z - (vertex + sag);
        if (abs(f) < 1e-7) {
            break;
        }
        float dsdr = asphere_sag_derivative(r, s);
        float drdt = 0.0;
        if (r > 1e-9) {
            drdt = (p.x * ray.dir.x + p.y * ray.dir.y) / r;
        }
        float dfdt = ray.dir.z - dsdr * drdt;
        if (abs(dfdt) < 1e-9) {
            break;
        }
        float t_next = t - f / dfdt;
        // keep t positive and limit step to avoid divergence
        if (t_next < 1e-6) {
            // no forward intersection
            break;
        }
        // clamp large jumps
        if (abs(t_next - t) > 10.0) {
            t_next = t + sign(t_next - t) * 10.0;
        }
        t = t_next;
        if (abs(f) < 1e-6) {
            break;
        }
    }

    vec3 pos = ray.pos + t * ray.dir;
    float r = length(pos.xy);
    // final check: ray must be forward and within reasonable bounds
    if (t < 1e-6 || t > 1e6) {
        i.hit = false;
        return i;
    }
    // check that we actually converged (residual small)
    {
        float sag = asphere_sag(r, s);
        float f = pos.z - (vertex + sag);
        if (abs(f) > 1e-4) {
            // fallback to sphere/plane if not converged and conic==0 and no coeffs
            // still return hit if close to vertex plane
            // but mark as miss if far
            if (abs(f) > 1e-3) {
                i.hit = false;
                return i;
            }
        }
    }

    float dsdr = asphere_sag_derivative(r, s);
    vec3 normal;
    if (r < 1e-9) {
        normal = vec3(0.0, 0.0, 1.0);
    } else {
        float invr = 1.0 / r;
        float dzdx = dsdr * pos.x * invr;
        float dzdy = dsdr * pos.y * invr;
        // surface: z = vertex + sag(r), gradient = (-dzdx, -dzdy, 1)
        normal = normalize(vec3(-dzdx, -dzdy, 1.0));
    }
    // ensure normal faces against incoming ray (needed for refraction)
    if (dot(normal, -ray.dir) < 0.0) {
        normal = -normal;
    }

    float incident = acos(clamp(dot(-ray.dir, normal), -1.0, 1.0));

    i.hit = true;
    i.incident = incident;
    i.pos = pos;
    i.normal = normal;
    return i;
}


// Calculate the intersection of a Ray with a Surface.
Intersection intersect(
    Ray ray,
    Surface surface
) {
    Intersection i;

    if (ray.dir.z == 0) {
        i.hit = false;
    } else if (surface.radius == 0) {
        i = intersect_plane(ray, -surface.center);
    } else if (use_aspheric && (surface.type == EVEN_ASPHERIC || surface.type == EXTENDED_ASPHERIC || surface.type == EXTENDED_ODD_ASPHERIC)) {
        i = intersect_asphere(ray, surface);
    } else if (use_aspheric && (surface.type == CYLINDER_X || surface.type == CYLINDER_Y)) {
        i = intersect_cylindrical(ray, -surface.center, surface.radius, surface.type);
    } else {
        i = intersect_sphere(ray, -surface.center, surface.radius);
    }
    return i;
}

