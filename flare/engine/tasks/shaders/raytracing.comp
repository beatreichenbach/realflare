// Initialize a Ray on a Surface with a direction.
void init_ray(inout Ray ray, Surface surface) {
    vec3 direction = ray.dir;

    // Cast Ray straight to the first surface.
    ray.pos.z = 1.0;
    ray.dir = vec3(0.0, 0.0, -1.0);
    Intersection i = intersect(ray, surface);

    // Restore the original direction and move Ray to surface.
    ray.dir = direction;
    ray.pos = i.hit ? i.pos - ray.dir : vec3(ray.pos.xy, 0.0);

}


void main() {
    uint ray_id = gl_GlobalInvocationID.x;
    uint wavelength_id = gl_GlobalInvocationID.y;
    uint wavelength_count = gl_NumWorkGroups.y * gl_WorkGroupSize.y;

    ivec2 path = ghosts[ghost_id].path;
    uint ray_offset = ghosts[ghost_id].offset;
    uint ray_count = ghosts[ghost_id].count;

    if (ray_id >= ray_count) {
        return;
    }

    // rays = (ghost, wavelength, ray)
    uint ray_index = (ray_offset * wavelength_count) + wavelength_id * ray_count + ray_id;
    float wavelength = float(wavelengths[wavelength_id]);

    Ray ray = rays[ray_index];
//    float scale = float(wavelength_id + 1u) / float(wavelength_count);
//    ray.pos *= scale;
//    ray.pos.x += float(ghost_id) * 0.1;
//    ray.pos.y = float(ray_id);
//    rays[ray_index] = ray;
//    return;
    init_ray(ray, surfaces[0]);

    // Step increases every time a ray bounces, there are always 3 steps.
    uint step = 0;
    uint inter_id = 0;
    int delta = 1;

    float previous_ior = 1.0;

    uint surface_id;
    for (surface_id = 0; surface_id < surface_count; inter_id++, surface_id = uint(int(surface_id) + delta)) {
        Surface surface = surfaces[surface_id];

        Intersection inter;
        inter = intersect(ray, surface);
        if(!inter.hit) {
            break;
        }

//        uint inter_index = ray_index * intersection_count + inter_id;
//        intersections[inter_index] = inter;

        // Update ray direction and position
        ray.pos = inter.pos;

        if (surface.type == STOP) {
            ray.pos_apt = inter.pos.xy / surface.height;
            // Skip reflection / refraction for the aperture
            continue;
        } else if (surface_id == surface_count - 1u) {
            // Skip reflection / refraction for the sensor plane
            continue;
        } else {
            float rrel = length(inter.pos.xy) / surface.height;
            ray.rrel = max(ray.rrel, rrel);
        }

        // Reverse direction of the ray
        bool do_reflect = false;
        if ((step == 0 && surface_id == path.x) || (step == 1 && surface_id == path.y)) {
            do_reflect = true;
            step++;
            delta = -delta;
        }

        // Get IOR for both materials
        uint ior_id = wavelength_count * surface_id + wavelength_id;
        float n1 = previous_ior;
        float n2 = iors[ior_id];
        previous_ior = iors[ior_id];

        if (do_reflect) {
            ray.dir = reflect(ray.dir, inter.normal);

            // Prevent divide by 0 errors
            float theta = max(inter.incident, 1e-6);
            float reflectance;
            if (surface.coating_ior > 0) {
                // The optimal coating ior is sqrt(n), with two mediums sqrt(n1 * n2)
                float nc = max(sqrt(n1 * n2), surface.coating_ior);

                // The optimal effective thickness of the coating using the wavelength
                // that the coating is optimized for in a vacuum.
                // https://en.wikipedia.org/wiki/Anti-reflective_coating#Interference_coatings
                float d1 = surface.coating_wavelength / (4.0f * nc);

                reflectance = fresnel_ar(theta, wavelength, d1, n1, nc, n2);
            } else {
                reflectance = fresnel_schlick(theta, n1, n2);
            }

            if (reflectance > 0) {
                ray.reflectance *= reflectance;
            }
        } else {
            float ratio = n1 / n2;
            ray.dir = refract(ray.dir, inter.normal, ratio);
            if(length(ray.dir) == 0) {
                // Total reflection
                break;
            }
        }
    }

    // Rays that exit early are invalid
    if (surface_id < surface_count) {
        ray.reflectance = INF;
    }

    rays[ray_index] = ray;
}
