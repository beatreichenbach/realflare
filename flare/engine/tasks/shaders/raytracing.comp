#version 430 core

#define INF (1.0/0.0)
#define M_PI 3.14159265359

#define STOP 0
#define STANDARD 1
#define EVEN_ASPHERIC 2
#define EXTENDED_ASPHERIC 3
#define EXTENDED_ODD_ASPHERIC 4
#define CYLINDER_X 5
#define CYLINDER_Y 6

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

struct Surface {
    uint type;
    float center;
    float radius;
    float height;
    vec4 coefficients;
    float conic;
    float coating_wavelength;
    float coating_ior;
    float _pad;
};

// TODO: remove dir and pos.z
struct Ray {
    vec3 pos;
    float rrel;
    vec3 dir;
    float reflectance;
    vec2 pos_apt;
    uint _pad[2];
};

struct Intersection {
    vec3 pos;
    float incident;
    vec3 normal;
    bool hit;
};

struct Ghost {
    ivec2 path;
    uint offset;
    uint count;
};

uniform Params {
    uint surface_count;
    uint intersection_count;
    bool use_aspheric;
    uint _pad;
};

uniform uint ghost_id;

layout(std430) buffer Surfaces {
    Surface surfaces[];
};
layout(std430) buffer Iors {
    float iors[];
};
layout(std430) buffer Wavelengths {
    float wavelengths[];
};
layout(std430) buffer Ghosts {
    Ghost ghosts[];
};
layout(std430) buffer Rays {
    Ray rays[];
};
layout(std430) buffer Intersections {
    Intersection intersections[];
};
layout(std430) buffer Positions {
    vec2 transforms[];
};

// Calculate the Fresnel reflectance
// https://en.wikipedia.org/wiki/Fresnel_equations
float fresnel(
    float theta0,
    float n1,
    float n2
) {
    float theta1 = asin(sin(theta0) * n1 / n2);
    float cosi = cos(theta0);
    float cost = cos(theta1);
    float rs = ((n1 * cosi) - (n2 * cost)) / ((n1 * cosi) + (n2 * cost));
    float rp = ((n1 * cost) - (n2 * cosi)) / ((n1 * cost) + (n2 * cosi));
    float r = (rs * rs + rp * rp) / 2;
    return r;
}

// Calculate the reflectivity for two media using Schlick's approximation
float fresnel_schlick(float theta0, float n1, float n2) {
    float cosi = cos(theta0);
    float r0 = (n1 - n2) / (n1 + n2);
    r0 = r0 * r0;
    return r0 + (1.0 - r0) * pow(1.0 - cosi, 5.0);
}

// Calculate the reflectivity for a wavelength passing through
// 2 mediums with a coating layer.
// [Ritschel et al. 2009] Supplemental Material - Anti-reflective Coating
float fresnel_ar(
    float theta0,  // angle of incidence
    float wavelength,  // wavelength of ray
    float d1,  // thickness of AR coating
    float n0,  // refractive index of 1st medium
    float n1,  // refractive index of coating layer
    float n2  // refractive index of 2nd medium
) {
    // Refraction angles in coating and the 2nd medium
    float theta1 = asin(sin(theta0) * n0 / n1);
    float theta2 = asin(sin(theta0) * n0 / n2);

    // Amplitude for outer refl. / transmission on topmost interface
    float rs01 = -sin(theta0 - theta1) / sin(theta0 + theta1);
    float rp01 = tan(theta0 - theta1) / tan(theta0 + theta1);
    float ts01 = 2 * sin(theta1) * cos(theta0) / sin(theta0 + theta1);
    float tp01 = ts01 * cos(theta0 - theta1);

    // Amplitude for inner reflection
    float rs12 = -sin(theta1 - theta2) / sin(theta1 + theta2);
    float rp12 = tan(theta1 - theta2) / tan(theta1 + theta2);

    // After passing through first surface twice:
    // 2 transmissions and 1 reflection
    float ris = ts01 * ts01 * rs12;
    float rip = tp01 * tp01 * rp12;

    // Phase difference between outer and inner reflections
    float dy = d1 * n1;
    float dx = tan(theta1) * dy;
    float delay = sqrt(dx * dx + dy * dy);
    float relPhase = 4 * M_PI / wavelength * (delay - dx * sin(theta0));

    // Add up sines of different phase and amplitude
    float out_s2 = rs01 * rs01 + ris * ris + 2 * rs01 * ris * cos(relPhase);
    float out_p2 = rp01 * rp01 + rip * rip + 2 * rp01 * rip * cos(relPhase);
    float reflectiviy = (out_s2 + out_p2) / 2;

    return reflectiviy;
}

Intersection intersect_plane(
    Ray ray,
    float center
) {
    Intersection i;

    // |ray.dir| / distance to intersecion = dz / ray.dir.z
    float dz = center - ray.pos.z;
    i.pos = ray.pos + ray.dir * (dz / ray.dir.z);
    i.normal = (ray.dir.z < 0) ? vec3(0, 0, 1) : vec3(0, 0, -1);
    i.hit = true;
    i.incident = 0.0f;

    return i;
}

// Spherical intersection
// https://www.bluebill.net/circle_ray_intersection.html
Intersection intersect_sphere(
    Ray ray,
    float center,
    float radius
) {
    Intersection i;

    float r = abs(radius);
    vec3 C = vec3(0, 0, center);

    vec3 U = C - ray.pos;
    vec3 U1 = dot(U, ray.dir) * ray.dir;
    float d = length(U - U1);

    // discard ray if it doesn't hit the sphere
    if (d > r) {
        i.hit = false;
        return i;
    }

    // dot(A, B) = |A||B|cos(theta)
    // theta = acos(dot(A, B) / |A||B|)
    // if A and B are unit vectors, |A||B| = 1
    // acos takes values from -1 to 1, otherwise nan
    float sgn = (radius * ray.dir.z) > 0 ? -1 : 1;
    float m = sqrt((r * r) - (d * d));
    vec3 pos = ray.pos + U1 - (m * ray.dir) * sgn;
    vec3 normal = normalize(pos - C) * sgn;
    float incident = acos(clamp(dot(-ray.dir, normal), -1.0f, 1.0f));

    i.hit = true;
    i.incident = incident;
    i.pos = pos;
    i.normal = normal;
    return i;
}

// Intersect a ray with an anamorphic (cylindrical) surface.
//
// A cylindrical surface is a circle of radius r that is swept along one axis,
// centered at z = center on the optical axis:
//   CYLINDER_X (swept along X, curved in Y-Z): y^2 + (z - center)^2 = r^2
//   CYLINDER_Y (swept along Y, curved in X-Z): x^2 + (z - center)^2 = r^2
// Substituting the ray position + t*dir gives a quadratic in the ray parameter
//   a*t^2 + b*t + c = 0
// which is solved for the first positive root. The normal lies in the curved
// plane, pointing from the axis (0, center) towards the hit point.
// https://en.wikipedia.org/wiki/Line-cylinder_intersection
Intersection intersect_cylindrical(
    Ray ray,
    float center,
    float radius,
    uint type
) {
    Intersection intersection;
    float r = abs(radius);
    float center_z = center;

    // Quadratic coefficients, a*t^2 + b*t + c = 0.
    float a;
    float b;
    float c;

    if (type == CYLINDER_X) {
        a = ray.dir.y * ray.dir.y + ray.dir.z * ray.dir.z;
        b = 2.0 * (ray.pos.y * ray.dir.y + (ray.pos.z - center_z) * ray.dir.z);
        c = ray.pos.y * ray.pos.y
            + (ray.pos.z - center_z) * (ray.pos.z - center_z) - r * r;
    } else { // CYLINDER_Y
        a = ray.dir.x * ray.dir.x + ray.dir.z * ray.dir.z;
        b = 2.0 * (ray.pos.x * ray.dir.x + (ray.pos.z - center_z) * ray.dir.z);
        c = ray.pos.x * ray.pos.x
            + (ray.pos.z - center_z) * (ray.pos.z - center_z) - r * r;
    }

    if (abs(a) < 1e-8) {
        intersection.hit = false;
        return intersection;
    }

    float discriminant = b * b - 4.0 * a * c;
    if (discriminant < 0.0) {
        intersection.hit = false;
        return intersection;
    }

    float sqrt_discriminant = sqrt(discriminant);
    float t_near = (-b - sqrt_discriminant) / (2.0 * a);
    float t_far = (-b + sqrt_discriminant) / (2.0 * a);

    // Pick the first intersection in front of the ray origin.
    float t = 1e30;
    if (t_near > 1e-6) t = t_near;
    if (t_far > 1e-6 && t_far < t) t = t_far;
    if (t > 1e29) {
        intersection.hit = false;
        return intersection;
    }

    vec3 position = ray.pos + t * ray.dir;

    // Orient the normal along the incoming direction, matching the sphere logic.
    float orientation = (radius * ray.dir.z) > 0.0 ? -1.0 : 1.0;
    vec3 normal;
    if (type == CYLINDER_X) {
        normal = normalize(vec3(0.0, position.y, position.z - center_z));
    } else {
        normal = normalize(vec3(position.x, 0.0, position.z - center_z));
    }
    normal *= orientation;

    float incident = acos(clamp(dot(-ray.dir, normal), -1.0, 1.0));

    intersection.hit = true;
    intersection.incident = incident;
    intersection.pos = position;
    intersection.normal = normal;
    return intersection;
}

// Aspheric sag helpers
//
// Return the sag z(r) of an aspheric surface at a radial distance r from the
// optical axis. It is the sum of a conic (quadric) term and a polynomial:
//
//   z(r) = c*r^2 / (1 + sqrt(1 - (1 + k)*c^2*r^2)) + sum(a_i * r^power)
//
// with vertex curvature c = 1 / radius and conic constant k.
// https://en.wikipedia.org/wiki/Aspheric_lens#Surface_profile
// https://en.wikipedia.org/wiki/Conic_constant
//
// The polynomial coefficients depend on the Zemax surface type:
//   EVENASPH / XASPHERE: a1*r^2 + a2*r^4 + a3*r^6 + a4*r^8
//   XOSPHERE:            a1*r^1 + a2*r^2 + a3*r^3 + a4*r^4
// https://ansyshelp.ansys.com/public/Views/Secured/Zemax/v251/en/OpticStudio_User_Guide/OpticStudio_Help/topics/Even_Asphere.html
//
// NOTE: Only the first 4 coefficients are uploaded which is a deliberate approximation.
// The optics database does not use normalized coefficients or a term mode.
float asphere_sag(float r, Surface surface) {
    float sag = 0.0;
    float c = 0.0;
    if (abs(surface.radius) > 1e-9) {
        c = 1.0 / surface.radius;
    }
    float k = surface.conic;
    float r2 = r * r;

    if (abs(c) > 1e-9) {
        float conic_factor = (1.0 + k) * c * c * r2;
        float radicand = 1.0 - conic_factor;
        radicand = max(radicand, 0.0);
        float root = sqrt(radicand);
        float denominator = 1.0 + root;
        if (abs(denominator) > 1e-9) {
            sag = c * r2 / denominator;
        }
    }

    if (surface.type == EVEN_ASPHERIC || surface.type == EXTENDED_ASPHERIC) {
        // coefficients are a1*r^2, a2*r^4, a3*r^6, a4*r^8
        float radius_power = r2; // r^2
        // unrolled for vec4
        sag += surface.coefficients.x * radius_power;
        radius_power *= r2; // r^4
        sag += surface.coefficients.y * radius_power;
        radius_power *= r2; // r^6
        sag += surface.coefficients.z * radius_power;
        radius_power *= r2; // r^8
        sag += surface.coefficients.w * radius_power;
    } else if (surface.type == EXTENDED_ODD_ASPHERIC) {
        // coefficients are a1*r^1, a2*r^2, a3*r^3, a4*r^4
        float radius_power = r; // r^1
        sag += surface.coefficients.x * radius_power;
        radius_power *= r; // r^2
        sag += surface.coefficients.y * radius_power;
        radius_power *= r; // r^3
        sag += surface.coefficients.z * radius_power;
        radius_power *= r; // r^4
        sag += surface.coefficients.w * radius_power;
    }
    return sag;
}

// Return the analytic derivative dz/dr of asphere_sag, used to build the surface normal.
// The conic slope is
//   dz/dr = c*r / sqrt(1 - (1 + k)*c^2*r^2)
// and the polynomial slopes are
//   even: 2*a1*r + 4*a2*r^3 + 6*a3*r^5 + 8*a4*r^7
//   odd:  a1 + 2*a2*r + 3*a3*r^2 + 4*a4*r^3
float asphere_sag_derivative(float r, Surface surface) {
    if (r < 1e-9) {
        // at apex the conic and even slopes are 0, only the odd a1*r term remains
        if (surface.type == EXTENDED_ODD_ASPHERIC) {
            return surface.coefficients.x; // d/dr (a1*r) = a1
        }
        return 0.0;
    }
    float sag_slope = 0.0;
    float c = 0.0;
    if (abs(surface.radius) > 1e-9) {
        c = 1.0 / surface.radius;
    }
    float k = surface.conic;
    float r2 = r * r;
    if (abs(c) > 1e-9) {
        float conic_factor = (1.0 + k) * c * c;
        float radicand = 1.0 - conic_factor * r2;
        radicand = max(radicand, 0.0);
        float root = sqrt(radicand);
        float denominator = 1.0 + root;
        if (abs(denominator) > 1e-9 && root > 1e-9) {
            // ds/dr = (2*c*r*denominator + c*r2*conic_factor*r/root) / denominator^2
            sag_slope = (
                2.0 * c * r * denominator + c * r2 * conic_factor * r / root
            ) / (denominator * denominator);
        } else if (abs(denominator) > 1e-9) {
            sag_slope = (2.0 * c * r) / denominator;
        }
    }
    if (surface.type == EVEN_ASPHERIC || surface.type == EXTENDED_ASPHERIC) {
        // even: a1*r^2 + a2*r^4 + a3*r^6 + a4*r^8
        // d/dr: 2*a1*r + 4*a2*r^3 + 6*a3*r^5 + 8*a4*r^7
        float radius_pow3 = r2 * r;
        float radius_pow5 = radius_pow3 * r2;
        float radius_pow7 = radius_pow5 * r2;
        sag_slope += 2.0 * surface.coefficients.x * r;
        sag_slope += 4.0 * surface.coefficients.y * radius_pow3;
        sag_slope += 6.0 * surface.coefficients.z * radius_pow5;
        sag_slope += 8.0 * surface.coefficients.w * radius_pow7;
    } else if (surface.type == EXTENDED_ODD_ASPHERIC) {
        // odd: a1*r + a2*r^2 + a3*r^3 + a4*r^4
        // d/dr: a1 + 2*a2*r + 3*a3*r^2 + 4*a4*r^3
        float radius_pow3 = r2 * r;
        sag_slope += surface.coefficients.x;
        sag_slope += 2.0 * surface.coefficients.y * r;
        sag_slope += 3.0 * surface.coefficients.z * r2;
        sag_slope += 4.0 * surface.coefficients.w * radius_pow3;
    }
    return sag_slope;
}

// Intersect a ray with an aspheric surface using Newton-Raphson on
//   f(t) = position.z(t) - (vertex + sag(r(t)))
// and derive the normal from the surface gradient
//   (-dz/dx, -dz/dy, 1)
Intersection intersect_asphere(
    Ray ray,
    Surface surface
) {
    Intersection intersection;
    float vertex = -surface.center + surface.radius; // vertex position along Z

    // initial guess: intersection with vertex plane
    float t = 1e30;
    if (abs(ray.dir.z) > 1e-9) {
        t = (vertex - ray.pos.z) / ray.dir.z;
    }
    if (t < 1e-6) {
        // if behind, try small forward step
        t = 1e-6;
    }

    // Newton iteration to solve f(t)=0 where f = ray.z(t) - (vertex + sag(r(t)))
    for (int iter = 0; iter < 12; ++iter) {
        vec3 position = ray.pos + t * ray.dir;
        float r = length(position.xy);
        float sag = asphere_sag(r, surface);
        float residual = position.z - (vertex + sag);
        if (abs(residual) < 1e-7) {
            break;
        }
        float sag_slope = asphere_sag_derivative(r, surface);
        float radius_rate = 0.0;
        if (r > 1e-9) {
            radius_rate = (position.x * ray.dir.x + position.y * ray.dir.y) / r;
        }
        float residual_rate = ray.dir.z - sag_slope * radius_rate;
        if (abs(residual_rate) < 1e-9) {
            break;
        }
        float next_t = t - residual / residual_rate;
        // keep t positive and limit step to avoid divergence
        if (next_t < 1e-6) {
            // no forward intersection
            break;
        }
        // clamp large jumps
        if (abs(next_t - t) > 10.0) {
            next_t = t + sign(next_t - t) * 10.0;
        }
        t = next_t;
        if (abs(residual) < 1e-6) {
            break;
        }
    }

    vec3 position = ray.pos + t * ray.dir;
    float r = length(position.xy);
    // final check: ray must be forward and within reasonable bounds
    if (t < 1e-6 || t > 1e6) {
        intersection.hit = false;
        return intersection;
    }
    // check that we actually converged (residual small)
    {
        float sag = asphere_sag(r, surface);
        float residual = position.z - (vertex + sag);
        if (abs(residual) > 1e-4) {
            // fallback to sphere/plane if not converged and conic==0 and no coeffs
            // still return hit if close to vertex plane
            // but mark as miss if far
            if (abs(residual) > 1e-3) {
                intersection.hit = false;
                return intersection;
            }
        }
    }

    float sag_slope = asphere_sag_derivative(r, surface);
    vec3 normal;
    if (r < 1e-9) {
        normal = vec3(0.0, 0.0, 1.0);
    } else {
        float inv_radius = 1.0 / r;
        float slope_x = sag_slope * position.x * inv_radius;
        float slope_y = sag_slope * position.y * inv_radius;
        // surface: z = vertex + sag(r), gradient = (-slope_x, -slope_y, 1)
        normal = normalize(vec3(-slope_x, -slope_y, 1.0));
    }
    // ensure normal faces against incoming ray (needed for refraction)
    if (dot(normal, -ray.dir) < 0.0) {
        normal = -normal;
    }

    float incident = acos(clamp(dot(-ray.dir, normal), -1.0, 1.0));

    intersection.hit = true;
    intersection.incident = incident;
    intersection.pos = position;
    intersection.normal = normal;
    return intersection;
}


// Calculate the intersection of a Ray with a Surface.
// Return the intersection of a ray with a surface, dispatching on the surface
// type. Cylindrical surfaces (CYLINDER_X / CYLINDER_Y) model anamorphic lenses.
Intersection intersect(
    Ray ray,
    Surface surface
) {
    Intersection intersection;

    if (ray.dir.z == 0) {
        intersection.hit = false;
    } else if (surface.radius == 0) {
        intersection = intersect_plane(ray, -surface.center);
    } else if (
        use_aspheric
        && (
            surface.type == EVEN_ASPHERIC
            || surface.type == EXTENDED_ASPHERIC
            || surface.type == EXTENDED_ODD_ASPHERIC
        )
    ) {
        intersection = intersect_asphere(ray, surface);
    } else if (
        use_aspheric
        && (surface.type == CYLINDER_X || surface.type == CYLINDER_Y)
    ) {
        intersection = intersect_cylindrical(
            ray, -surface.center, surface.radius, surface.type
        );
    } else {
        intersection = intersect_sphere(ray, -surface.center, surface.radius);
    }
    return intersection;
}

